# RAWbreach environment variables
# Copy to .env (never commit .env) or set these in your hosting dashboard.
# Note: the app reads real environment variables; it does not auto-load .env files.
# Locally:  export $(grep -v '^#' .env | xargs)   then   python app.py

# Optional. Have I Been Pwned API v3 key. When set, email lookups use HIBP;
# when empty, the free XposedOrNot API is used.
# Free test key (only works for @hibp-integration-tests.com demo addresses):
#   00000000000000000000000000000000
HIBP_API_KEY=

# Optional. Port for local development (python app.py). Defaults to 5001.
# Render sets PORT automatically in production.
PORT=5001
